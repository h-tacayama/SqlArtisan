<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 is a Roslyn analyzer hosting requirement, not a runtime choice (#93). -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
    <!--
      The release-tracking rules diff the descriptors against AnalyzerReleases.*.md; as
      warnings they let a renumbered or recategorized rule ship unnoticed (#655).
    -->
    <WarningsAsErrors>$(WarningsAsErrors);RS2000;RS2001;RS2002;RS2003;RS2004;RS2005;RS2006;RS2007;RS2008</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!--
      PrivateAssets=all keeps these off this project's own dependency surface,
      so consumers of the bundling SqlArtisan package never inherit compiler
      packages. Pack-time filtering has its own guard — see the
      _PackSqlArtisanAnalyzer comment in SqlArtisan.csproj.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

</Project>
